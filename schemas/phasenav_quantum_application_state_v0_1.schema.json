{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phasenav.quantum-application-state.v0.1",
  "title": "PhaseNav Quantum Application State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state_id",
    "backend_class",
    "branches",
    "relation_tensor",
    "scalar_fields",
    "tau",
    "residual",
    "provenance",
    "observed"
  ],
  "properties": {
    "schema": {
      "const": "PHASENAV_QUANTUM_APPLICATION_STATE_V0_1"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "backend_class": {
      "enum": [
        "PHASENAV_DIGITAL",
        "PHASENAV_ANALOG_CANDIDATE",
        "QPU_PHYSICAL",
        "HYBRID"
      ]
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "phase36",
          "amplitude_re",
          "amplitude_im"
        ],
        "properties": {
          "branch_id": {
            "type": "string",
            "minLength": 1
          },
          "phase36": {
            "type": "array",
            "minItems": 36,
            "maxItems": 36,
            "items": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 6.283185307179586
            }
          },
          "amplitude_re": {
            "type": "number"
          },
          "amplitude_im": {
            "type": "number"
          }
        }
      }
    },
    "relation_tensor": {
      "type": "object"
    },
    "scalar_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "tau": {
      "type": "number"
    },
    "residual": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "observed": {
      "type": "boolean"
    },
    "observation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "observable_id",
        "kernel",
        "result"
      ],
      "properties": {
        "observable_id": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            0,
            1
          ]
        },
        "post_state_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observed": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "observation"
        ]
      },
      "else": {
        "properties": {
          "observation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
